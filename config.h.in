/* config.h.in - Configuration header for hpdftbl library */

#ifndef CONFIG_H
#define CONFIG_H

/* Define to 1 if you have the jansson library (-ljansson). */
#cmakedefine HAVE_LIBJANSSON @HAVE_LIBJANSSON@

/* Version number of package */
#define VERSION "@PROJECT_VERSION@"

/* Name of package */
#define PACKAGE "@PROJECT_NAME@"

/* Define to the address where bug reports for this package should be sent. */
#define PACKAGE_BUGREPORT "johan162@gmail.com"

/* Define to the full name of this package. */
#define PACKAGE_NAME "@PROJECT_NAME@"

/* Define to the full name and version of this package. */
#define PACKAGE_STRING "@PROJECT_NAME@ @PROJECT_VERSION@"

/* Define to the version of this package. */
#define PACKAGE_VERSION "@PROJECT_VERSION@"

#endif /* CONFIG_H */
